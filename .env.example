# Copy to .env and adjust. Never commit .env.

# Database
DB_PASSWORD=mediconnect
DB_ROOT_PASSWORD=change-me-root

# Base64-encoded secret of at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Optional: turns MediBot from document-search mode into LLM mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: real email delivery (otherwise emails are logged by the outbox worker)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Fill the database with a month of realistic demo activity on first start
SEED_DEMO_DATA=true
TZ=Asia/Kolkata
